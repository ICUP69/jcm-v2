# Local testing for the review form. Copy to .env.local (gitignored) and fill in:
#   cp .env.example .env.local
#   node --env-file-if-exists=.env.local scripts/dev.mjs
#
# In production these are set in Vercel → Project Settings → Environment Variables,
# never committed.

# A real Resend key is needed for a test submission to actually send.
RESEND_API_KEY=

# Cloudflare's always-pass Turnstile test secret — keep this one locally rather than the
# real secret. The real sitekey in reviews/index.html only renders on localhost if
# localhost is added to the widget's hostnames in Cloudflare; otherwise temporarily swap
# the page back to the test sitekey 1x00000000000000000000AA (don't commit that).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Send test reviews to yourself, not to Juan. Production leaves this unset.
REVIEW_TO=

# Optional. Defaults to "JCruzz Media Reviews <reviews@lakeandpinecollective.com>".
# REVIEW_FROM=
